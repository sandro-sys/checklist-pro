# ========================================
# CheckList Pro - Variáveis de Ambiente
# ========================================
# Copie este arquivo para .env e preencha os valores

# Ambiente (development | production)
NODE_ENV=development

# Porta do servidor
PORT=3001

# ========================================
# JWT - Autenticação
# ========================================
# Gere chaves seguras: openssl rand -hex 64
JWT_SECRET=sua_chave_secreta_aqui
REFRESH_TOKEN_SECRET=outra_chave_secreta_aqui

# ========================================
# Banco de Dados
# ========================================
# Em desenvolvimento: usa SQLite local (não precisa configurar)
# Em produção: PostgreSQL (Render, Neon, Supabase, etc)
DATABASE_URL=postgresql://user:password@host:5432/database

# ========================================
# Frontend URL (para CORS)
# ========================================
# Em desenvolvimento
FRONTEND_URL=http://localhost:5173
# Em produção (exemplo Render)
# FRONTEND_URL=https://seu-app.onrender.com

# ========================================
# Mercado Pago - Pagamentos
# ========================================
# Obtenha suas credenciais em: https://www.mercadopago.com.br/developers
# Use credenciais de TESTE durante desenvolvimento
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# ========================================
# Rate Limiting (opcional)
# ========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
ENABLE_RATE_LIMIT=false

